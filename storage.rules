rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidPdf() {
      return request.resource.contentType == 'application/pdf'
        && request.resource.size <= 50 * 1024 * 1024; // 50MB maximum
    }
    
    function isValidImage(maxSizeMb) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size <= maxSizeMb * 1024 * 1024;
    }

    // Educational resource PDFs: /resources/{userId}/{resourceId}/document.pdf
    match /resources/{userId}/{resourceId}/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidPdf();
      allow delete: if isOwner(userId);
    }

    // Cover images: /covers/{userId}/{resourceId}/{fileName}
    match /covers/{userId}/{resourceId}/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidImage(10);
      allow delete: if isOwner(userId);
    }

    // User profile avatars: /avatars/{userId}/{fileName}
    match /avatars/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidImage(5);
      allow delete: if isOwner(userId);
    }
  }
}
